# Copy this file to ".env" (same folder) and fill in your details.
# server/.env is gitignored — your password never enters the repo,
# and it is never sent to the phone.
#
# For Gmail you must use an App Password, NOT your normal account password:
#   1. Google Account -> Security -> turn on 2-Step Verification
#   2. Google Account -> Security -> App passwords
#   3. Generate one for "Mail" and paste the 16-character value below
#
# Revoke it from that same page at any time to instantly cut Jarvis off.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
